# ============================================================================
#  Example environment file — copy to `.env` for local scripts
#  (`cp .env.example .env`).  NEVER commit `.env`.
# ============================================================================
#  These two values come from YOUR Supabase project:
#     Supabase dashboard → Project settings → API
#
#     SUPABASE_URL       = the "Project URL", e.g. https://abcdefghijk.supabase.co
#     SUPABASE_ANON_KEY  = the "anon public" key (safe to embed in a browser
#                          bundle; Row Level Security protects the data)
#
#  ⚠ Do NOT paste the `service_role` key here.  It bypasses Row Level
#    Security, and `scripts/set-env.mjs` refuses to build with it.
# ============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-publishable-key

# --- Optional ---------------------------------------------------------------
# Restrict registration to one college domain (leave empty to accept any).
# Write it without the @ sign.
COLLEGE_EMAIL_DOMAIN=

# Branding and defaults
APP_NAME=Smart Campus Lost and Found
SUPPORT_EMAIL=lostfound@campus.edu
MATCH_MIN_SCORE=40
PAGE_SIZE=9

# --- Optional live Supabase acceptance test ---------------------------------
# Tests require an existing administrator provisioned out-of-band (see
# START-HERE.md). Keep actual credentials only in the ignored local .env file.
E2E_EMAIL_DOMAIN=example.test
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
